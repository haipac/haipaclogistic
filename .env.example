# Static frontend build; local builds stay on Firebase emulators by default.
HAIPAC_MODE=emulator
HAIPAC_API_BASE_URL=/api/
HAIPAC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Firebase Functions project parameters. The deploy workflow targets this project explicitly.
FIREBASE_PROJECT_ID=haipac-7e19d
HAIPAC_FUNCTION_REGION=us-east4
HAIPAC_PUBLIC_URL=https://haipac-7e19d.web.app
EMAIL_FROM=
LEGAL_CONTENT_APPROVED=false
OPERATIONS_READY=false

# Emulator-only secret names. Use synthetic values locally; production values belong in Firebase Secret Manager.
SMARTCUT_HMAC_SECRET=
CLAIM_TOKEN_ENCRYPTION_KEY=
DELIVERY_CODE_SECRET=
TRACKING_RATE_LIMIT_SECRET=
RESEND_API_KEY=
CRON_SECRET=

# One-time owner bootstrap; never commit or share a real UID.
INITIAL_ADMIN_EMAIL=haipaclogistics@gmail.com
INITIAL_ADMIN_UID=
